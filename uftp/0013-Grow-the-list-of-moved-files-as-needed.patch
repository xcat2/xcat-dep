Date: Sun, 18 Oct 2026 10:00:00 -0300
Subject: [PATCH 13/23] Grow the list of moved files as needed

At the end of a group, move_files() kept the path of each top level
entry that it moved from the temp directory in an array of 10000
entries on the stack, without a bound. A group with more top level
entries wrote past the array. Keep the list in memory that grows as
needed.
---
 client_transfer.c | 43 +++++++++++++++++++++++++++++--------------
 1 file changed, 29 insertions(+), 14 deletions(-)

diff --git a/client_transfer.c b/client_transfer.c
index ba1ff82..fe1eb55 100644
--- a/client_transfer.c
+++ b/client_transfer.c
@@ -183,14 +183,36 @@ void move_files_individual(struct group_list_t *group, const char *local_temp,
     }
 }
 
+/**
+ * Adds a copy of path to a list of moved files, which grows as needed
+ */
+static void add_moved_file(struct group_list_t *group, char ***filelist,
+                           int *filecount, int *filemax, const char *path)
+{
+    if (*filecount == *filemax) {
+        *filemax = *filemax ? *filemax * 2 : 64;
+        *filelist = realloc(*filelist, *filemax * sizeof(char *));
+        if (*filelist == NULL) {
+            gsyserror(group, "realloc failed!");
+            exit(ERR_ALLOC);
+        }
+    }
+    (*filelist)[*filecount] = strdup(path);
+    if ((*filelist)[*filecount] == NULL) {
+        gsyserror(group, "strdup failed!");
+        exit(ERR_ALLOC);
+    }
+    (*filecount)++;
+}
+

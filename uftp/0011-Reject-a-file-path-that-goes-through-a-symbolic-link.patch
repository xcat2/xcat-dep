Date: Sun, 18 Oct 2026 10:00:00 -0300
Subject: [PATCH 11/23] Reject a file path that goes through a symbolic link

A FILEINFO of type link creates a symbolic link to any target. For a
later file below that link, create_path_to_file() replaced the link
only when it was the parent directory of the file. lstat() follows
links in the other components, so a name such as "link/etc/passwd"
made the client delete and write a file outside its destination.
Reject a file when a directory in its path below the destination
directory, or below the temp directory of the group, is a symbolic
link.
---
 client_fileinfo.c | 39 +++++++++++++++++++++++++++++++++++++--
 1 file changed, 37 insertions(+), 2 deletions(-)

diff --git a/client_fileinfo.c b/client_fileinfo.c
index e890a30..f600a21 100644
--- a/client_fileinfo.c
+++ b/client_fileinfo.c
@@ -190,13 +190,41 @@ int read_fileinfo(struct group_list_t *group, const unsigned char *message,
     return 1;
 }
 
+/**
+ * Returns 1 if a directory in path after its first root_len characters
+ * is a symbolic link, 0 otherwise
+ */
+static int link_in_path(const char *path, int root_len)
+{
+#ifndef WINDOWS
+    char dir[MAXPATHNAME];
+    stat_struct statbuf;
+    int i;
+
+    for (i = root_len + 1; path[i] != '\x0'; i++) {
+        if ((path[i] != PATH_SEP) || (path[i - 1] == PATH_SEP)) {
+            continue;
+        }
+        memcpy(dir, path, i);
+        dir[i] = '\x0';
+        if (lstat_func(dir, &statbuf) == -1) {
+            return 0;
+        }
+        if (S_ISLNK(statbuf.st_mode)) {
+            return 1;
+        }
+    }
+#endif
+    return 0;
+}
+
 /**
  * Validate and establish the destination name of an incoming file.
  * Returns 0 if the file was rejected for some reason, 1 otherwise.
  */
 int setup_dest_file(struct group_list_t *group)
 {
-    int found_dest_dir, len, i;
+    int found_dest_dir, len, i, root_len;
     int (*cmp)(const char *, const char *);
     int (*ncmp)(const char *, const char *, size_t);
 
@@ -251,6 +279,7 @@ int setup_dest_file(struct group_list_t *group)
         group->fileinfo.destdiridx = i;
         snprintf(group->fileinfo.filepath,
             sizeof(group->fileinfo.filepath), "%s", group->fileinfo.name);
+        root_len = strlen(destdir[i]);
     } else {
         if (!strcmp(tempdir, "")) {
             len = snprintf(group->fileinfo.filepath,
@@ -267,7 +296,13 @@ int setup_dest_file(struct group_list_t *group)
             early_complete(group, COMP_STAT_REJECTED, 0);
             return 0;
         }
-
+        root_len = len - strlen(group->fileinfo.name) - 1;
+    }
+    if (link_in_path(group->fileinfo.filepath, root_len)) {
+        glog1(group, "Rejecting file: a directory in its path is a "
+                     "symbolic link");
+        early_complete(group, COMP_STAT_REJECTED, 0);
+        return 0;
     }
     len = snprintf(group->fileinfo.temppath, sizeof(group->fileinfo.temppath),
                    "%s.~uftp-%08X-%04X", group->fileinfo.filepath,

From: =?UTF-8?q?Vin=C3=ADcius=20Ferr=C3=A3o?= <2031761+viniciusferrao@users.noreply.github.com>
Date: Sun, 18 Oct 2026 10:00:00 -0300
Subject: [PATCH 12/23] Reject a file whose section count does not fit

The section count of a file is a 16 bit field. With a block size of 512
bytes, a file of 128 GiB has 65536 sections, which the client and the
sender stored as 0 and then divided by. Reject such a file: the client
rejects its FILEINFO, and the sender stops with a parameter error.
---
 client_fileinfo.c | 7 +++++++
 server_send.c     | 6 ++++++
 2 files changed, 13 insertions(+)

diff --git a/client_fileinfo.c b/client_fileinfo.c
index f600a21..64d9ee7 100644
--- a/client_fileinfo.c
+++ b/client_fileinfo.c
@@ -130,6 +130,13 @@ int read_fileinfo(struct group_list_t *group, const unsigned char *message,
     if (group->fileinfo.size) {
         maxsecsize = (group->blocksize * 8 > MAXSECTION ?
                 MAXSECTION : group->blocksize * 8);
+        if ((group->fileinfo.size + group->blocksize - 1) / group->blocksize >
+                (f_offset_t)maxsecsize * 0xFFFF) {
+            glog1(group, "Rejecting FILEINFO from server: file too large");
+            group->fileinfo.fd = -1;
+            early_complete(group, COMP_STAT_REJECTED, 0);
+            return 0;
+        }
         group->fileinfo.blocks =
                 (int32_t)((group->fileinfo.size / group->blocksize) +
                 (group->fileinfo.size % group->blocksize ? 1 : 0));
diff --git a/server_send.c b/server_send.c
index fd8521d..4e98146 100644
--- a/server_send.c
+++ b/server_send.c
@@ -172,6 +172,12 @@ int send_file(const char *f_basedir, const char *filename,
         finfo.tstamp = statbuf.st_mtime;
 
         maxsecsize = (blocksize * 8 > MAXSECTION ? MAXSECTION : blocksize * 8);
+        if ((finfo.size + blocksize - 1) / blocksize >
+                (f_offset_t)maxsecsize * 0xFFFF) {
+            log0(group_id, 0, 0, "Cannot send %s: too large for block size %d",
+                 filename, blocksize);
+            return ERR_PARAM;
+        }
         if (finfo.size) {
             finfo.blocks = (int32_t)((finfo.size / blocksize) +
                     (finfo.size % blocksize ? 1 : 0));

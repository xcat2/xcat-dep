From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Vin=C3=ADcius=20Ferr=C3=A3o?= <2031761+viniciusferrao@users.noreply.github.com>
Date: Sun, 18 Oct 2026 10:00:00 -0300
Subject: [PATCH 4/23] Reject FILESEG for a block the file does not have

handle_fileseg() turns the section and the block of a FILESEG into an
offset in naklist, which holds one byte for each block of the file. It
did not check them, so a FILESEG for a block past its section or past
the end of the file made the client read and write past naklist.
Reject such a FILESEG.
---
 client_transfer.c | 19 +++++++++++++++----
 1 file changed, 15 insertions(+), 4 deletions(-)

diff --git a/client_transfer.c b/client_transfer.c
index abd8fc6..5100728 100644
--- a/client_transfer.c
+++ b/client_transfer.c
@@ -658,7 +658,7 @@ void handle_fileseg(struct group_list_t *group, const unsigned char *message,
     const unsigned char *data;
     const uint8_t *he;
     int datalen, section, cache_offset, status_idx;
-    uint32_t seq, i;
+    uint32_t seq, i, sec_block, blocks_this_sec;
     unsigned extlen;
 
     if (group->fileinfo.ftype != FTYPE_REG) {
@@ -695,13 +695,24 @@ void handle_fileseg(struct group_list_t *group, const unsigned char *message,
     }
 
     section = ntohs(fileseg->section);
+    sec_block = ntohs(fileseg->sec_block);
+    if (section >= group->fileinfo.sections) {
+        glog2(group, "Rejecting FILESEG: invalid section %d", section);
+        return;
+    }
     if (section >= group->fileinfo.big_sections) {
         seq = (group->fileinfo.big_sections * group->fileinfo.secsize_big) +
                 ((section - group->fileinfo.big_sections) *
-                group->fileinfo.secsize_small) + ntohs(fileseg->sec_block);
+                group->fileinfo.secsize_small) + sec_block;
+        blocks_this_sec = group->fileinfo.secsize_small;
     } else {
-        seq = (section * group->fileinfo.secsize_big) +
-                ntohs(fileseg->sec_block);
+        seq = (section * group->fileinfo.secsize_big) + sec_block;
+        blocks_this_sec = group->fileinfo.secsize_big;
+    }
+    if (sec_block >= blocks_this_sec) {
+        glog2(group, "Rejecting FILESEG: invalid block %u in section %d",
+                     sec_block, section);
+        return;
     }
 
     if ((datalen != group->blocksize) &&

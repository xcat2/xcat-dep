From: =?UTF-8?q?Vin=C3=ADcius=20Ferr=C3=A3o?= <2031761+viniciusferrao@users.noreply.github.com>
Date: Sat, 17 Oct 2026 16:30:00 -0300
Subject: [PATCH 2/23] Keep the client lists of the proxy inside the packet buffer

max_msg_dest() ignored the header length that its callers pass, and
allowed blocksize bytes of client IDs or keys after the header. The
KEYINFO key list follows a signature, so with -b 8800 and an RSA-2048
proxy key it ran past the 9000 byte buffer. Bound every list by the
space left after the header and the encryption overhead, as
send_multiple() does.
---
 proxy_common.c | 23 ++++++++++++++++++-----
 1 file changed, 18 insertions(+), 5 deletions(-)

diff --git a/proxy_common.c b/proxy_common.c
index 2af1725..acd5ffa 100644
--- a/proxy_common.c
+++ b/proxy_common.c
@@ -236,18 +236,31 @@ void set_timeout(struct pr_group_list_t *group, int pending_reset, int rescale)
  */
 int max_msg_dest(struct pr_group_list_t *group, int func, int hlen)
 {
+    int size, room;
+
     switch (func) {
     case REGISTER:
-        return (group->blocksize / sizeof(uint32_t));
-    case KEYINFO:
-        return (group->blocksize / sizeof(struct destkey));
     case FILEINFO_ACK:
-        return (group->blocksize / sizeof(uint32_t));
     case COMPLETE:
-        return (group->blocksize / sizeof(uint32_t));
+        size = sizeof(uint32_t);
+        break;
+    case KEYINFO:
+        size = sizeof(struct destkey);
+        break;
     default:
         return 0;
     }
+    // The list must fit in the MAXMTU buffer after the message header,
+    // which holds key exchange data or a signature. Leave room for the
+    // encryption header and tag of encrypted messages.
+    room = MAXMTU - (int)sizeof(struct uftp_h) - hlen;
+    if (group->keytype != KEY_NONE) {
+        room -= (int)sizeof(struct encrypted_h) + KEYBLSIZE;
+    }
+    if ((int)group->blocksize < room) {
+        room = (int)group->blocksize;
+    }
+    return room / size;
 }
 
